# Copy to .env locally. Never commit credentials or wallet files.
ORACLE_USER=
ORACLE_PASSWORD=
# Require TLS: tcps://host:1522/service or a tcps connect descriptor.
ORACLE_DSN=
# For mTLS: directory containing tnsnames.ora and ewallet.pem.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
SIMILARITY_THRESHOLD=0.25
# For a separate READ-only API user, set the owner of the corpus tables.
ORACLE_DATA_SCHEMA=
ORACLE_WRITE_USER=
ORACLE_WRITE_PASSWORD=
UPLOAD_MAX_BYTES=5000000
UPLOAD_MAX_PAGES=40
UPLOAD_MAX_CHARS=120000
UPLOAD_MAX_CHUNKS=128

# Optional. Leave all three blank to keep retrieval available without generation.
LLM_PROVIDER=
GEMINI_API_KEY=
LLM_MODEL=
